APP_NAME=NexStore

HOST=127.0.0.1
PORT=8000

REPLICATION_FACTOR=3

HEALTH_CHECK_INTERVAL=5
HEARTBEAT_TIMEOUT=15
REPAIR_INTERVAL=5
INTEGRITY_CHECK_INTERVAL=30
REBALANCE_THRESHOLD=80

MAX_STORAGE_PER_NODE=10737418240
MAX_UPLOAD_SIZE=536870912
NODE_COUNT=5

# Supabase (required for production auth)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Google OAuth (optional — via Supabase Auth providers)
# Configure in: Supabase Dashboard → Authentication → Providers → Google
